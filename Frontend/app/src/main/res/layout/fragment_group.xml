<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvFoodPlan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Food Plan"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/planNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvFoodPlan"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/planName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/planNameLabel"
        app:layout_constraintStart_toEndOf="@id/planNameLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/caloriesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calories: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/planNameLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/calories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/caloriesLabel"
        app:layout_constraintStart_toEndOf="@id/caloriesLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/totalFatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Fat: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/caloriesLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/totalFat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/totalFatLabel"
        app:layout_constraintStart_toEndOf="@id/totalFatLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/sodiumLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sodium: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/totalFatLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/sodium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/sodiumLabel"
        app:layout_constraintStart_toEndOf="@id/sodiumLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/carbohydrateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Carbohydrates: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/sodiumLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/carbohydrate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/carbohydrateLabel"
        app:layout_constraintStart_toEndOf="@id/carbohydrateLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/proteinLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protein: "
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/carbohydrateLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/protein"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/proteinLabel"
        app:layout_constraintStart_toEndOf="@id/proteinLabel"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/groupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/proteinLabel"
        app:layout_constraintStart_toStartOf="@id/tvFoodPlan"
        app:layout_constraintEnd_toEndOf="@id/tvFoodPlan"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/memberName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/groupName"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingBottom="8dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_card"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/memberName">

        <TextView
            android:id="@+id/groupChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Group Chat"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/btnEnter"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnEnter"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Enter"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
